# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (individual vars; ignored when DATABASE_URL is set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tradewars
DB_USER=postgres
DB_PASSWORD=your_password_here

# ...or a single connection URL (Railway, Render, etc. provide this).
# Takes precedence over the individual DB_* vars above when set.
# DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/tradewars

# JWT Secret
JWT_SECRET=your_jwt_secret_here_change_in_production

# CORS Origins
CORS_ORIGIN_CLIENT=http://localhost:5173
CORS_ORIGIN_ADMIN=http://localhost:5174
